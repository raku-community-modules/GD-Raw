# -*- encoding: utf-8; indent-tabs-mode: nil -*-
use Test;
use GD::Raw;
use NativeCall;

use lib $*PROGRAM.parent;
use gdtest;

plan 1;

my $width  = 500;
my $height =  50;
my $im     = gdImageCreate($width, $height);
LEAVE gdImageDestroy($im) if $im;

my $white     = gdImageColorAllocate($im, 255, 255, 255);
my $black     = gdImageColorAllocate($im,   0,   0,   0);
my $font-name = $*PROGRAM.sibling("ported-gdimagestringft/testing-gd-raw.ttf").Str;
my $font-size = 30e0; # float, not int
my $angle     =  0e0; # ditto

my @bounding-rect := CArray[int32].new;
@bounding-rect[7] = 0; # to allocate room for 8 integers

my $rc = gdFontCacheSetup();
LEAVE gdFontCacheShutdown();
# zero : do not use generic font names
my $config = gdFTUseFontConfig(0);

# negative color to disable anti-aliasing
my $err = gdImageStringFT($im, @bounding-rect, - $black, $font-name, $font-size, $angle, 10, 40, "Hello world");
die $err if $err;

ok gdAssertBWImageEqualsToFile
  $*PROGRAM.sibling("ported-gdimagestringft/gdimagetextft.png"),
  $im
;

#
# Subroutines copied from gdtest, to allow some leeway in B&W pictures
#
sub tmp-file() {
    my $path  = $*TMPDIR;
    my @chars = 'a' .. 'z';
    @chars.push( | ('A' .. 'Z'));
    $path = $path.child( @chars.pick(10).join ~ ".png" );
    $path.Str
}

sub gdAssertBWImageEqualsToFile(Str() $ex,$ac) is export {
    gdTestBWImageCompareToFile("caller",0, Str,$ex,$ac);
}

sub gdTestBWImageFromPng(Cool $filename)
{
    my $fp = fopen($filename, "rb");
    return unless $fp;
    LEAVE fclose($fp) if $fp;
    gdImageCreateFromPng($fp);
}

sub gdTestBWImageCompareToFile(Cool $file, Int $line,
    Str $message, Str $expected_file, gdImagePtr $actual)
{
    my $expected = gdTestBWImageFromPng($expected_file);

    unless $expected {
        warn "Cannot open PNG " ~ $expected_file;
        return 0;
    }

    LEAVE gdImageDestroy($expected) if $expected;
    gdTestBWImageCompareToImage($file, $line, $message, $expected, $actual)
}

sub gdTestBWImageCompareToImage($file, $line, $message,
                              $expected, $actual)
{
    my Int ($width_a, $height_a);
    my Int ($width_b, $height_b);
    my gdImagePtr $surface_diff;
    my $result = CuTestImageResult.new;

    unless $actual {
        warn "actual missing";
        return 0;
    }

    $width_a  = gdImageSX($expected);
    $height_a = gdImageSY($expected);
    $width_b  = gdImageSX($actual);
    $height_b = gdImageSY($actual);

    if $width_a  != $width_b  || $height_a != $height_b {
        warn "Image size mismatch: ($width_a x $height_a) vs. "
            ~ "($width_b x $height_b)\n\t for $file vs. buffer\n";
        return 0;
    }

    $surface_diff = gdImageCreateTrueColor($width_a, $height_a);
    LEAVE gdImageDestroy($surface_diff) if $surface_diff;

    gdTestBWImageDiff($expected, $actual, $surface_diff, $result);
    if $result.pixels_changed > 0 {
        my Str $file_diff;
        my Str $file_out;
        my OpaquePointer $fp;
        my int ($len, $p);

        warn "Total pixels changed: " ~ $result.pixels_changed
            ~ " with a maximum channel difference of " ~ gdMaxPixelDiff($expected, $actual);

        my $actual-path = tmp-file();
        my $diff-path   = tmp-file();

        my $afh = fopen($actual-path, "wb");
        return 0 unless $afh;
        my $dfh = fopen($diff-path, "wb");
        return 0 unless $dfh;

        say "Writing actual to $actual-path, expected to $diff-path";
        gdImagePng($actual, $afh);
        gdImagePng($expected, $dfh);

        LEAVE {
            fclose($afh) if $afh;
            fclose($dfh) if $dfh;
        }

        return 0;
    }

    1
}

# Compare two buffers, returning the number of pixels that are
# different and the maximum difference of any single color channel in
# result_ret.
#
# The difference between this function and the corresponding function in gdtest.rakutest
# is that in this function, at the border between a white area and a black area,
# we allow some border pixels to be white in one picture and black in the other picture.
#
# This function should be rewritten to compare all formats supported by
# cairo_format_t instead of taking a mask as a parameter.
#
sub gdTestBWImageDiff(gdImagePtr $buf_a, gdImagePtr $buf_b,
                     gdImagePtr $buf_diff, CuTestImageResult $result_ret is rw)
{
    my int ($x, $y);
    my int ($c1, $c2);

    my $x-max = gdImageSX($buf_a) - 1;
    my $y-max = gdImageSY($buf_a) - 1;
    loop ($y = 0; $y < gdImageSY($buf_a); $y++) {
        loop ($x = 0; $x < gdImageSX($buf_a); $x++) {
            $c1 = gdImageGetTrueColorPixel($buf_a, $x, $y);
            $c2 = gdImageGetTrueColorPixel($buf_b, $x, $y);

            # check if the pixels are the same
            if $c1 != $c2 {

                # if a **border** pixel in file 1 is different from the **inner** pixel in file 2
                # at the same coords, we **count** the difference

                # if an **inner** pixel in file 1 is different from the **border** pixel in file 2
                # at the same coords, we **count** the difference

                # if both pixels from file 1 and file 2 are **inner** pixels, we **count** the difference, of course

                # if both pixels from file 1 and file 2 are **border** pixels, we **discard** the difference

                # inner pixel: a white pixel surrounded by four white pixels, or a black pixel surrounded by four black pixels
                # border pixel: a black pixel with at least one white neighbour or a white pixel with at least one black neighbour
                my $border1 = False;
                my $border2 = False;
                for <0 1 1 0 0 -1 -1 0> -> $dx, $dy {
                  # make sure the neighbour is within the picture
                  if 0 ≤ $x + $dx ≤ $x-max && 0 ≤ $y + $dy ≤ $y-max {
                    my $neighbour = gdImageGetTrueColorPixel($buf_a, $x + $dx, $y + $dy);
                    if $neighbour ≠ $c1 {
                      $border1 = True;
                    }
                    $neighbour = gdImageGetTrueColorPixel($buf_b, $x + $dx, $y + $dy);
                    if $neighbour ≠ $c2 {
                      $border2 = True;
                    }
                  }
                }
                #say "$x $y $border1 $border2";
                last if $border1 && $border2;

                my int ($r1,$b1,$g1,$a1,$r2,$b2,$g2,$a2);
                my ($diff_a,$diff_r,$diff_g,$diff_b);

                $a1 = gdTrueColorGetAlpha($c1);
                $a2 = gdTrueColorGetAlpha($c2);
                $diff_a = ($a1 - $a2).abs;
                $diff_a *= 4; # emphasize

                if $diff_a {
                    $diff_a += 128; # make sure it's visible
                }

                if $diff_a > gdAlphaMax {
                    $diff_a = gdAlphaMax/2;
                }

                $r1 = gdTrueColorGetRed($c1);
                $r2 = gdTrueColorGetRed($c2);
                $diff_r = ($r1 - $r2).abs;
                $diff_r *= 4; # TODO: This line commented out or not?
                if $diff_r {
                    $diff_r += gdRedMax/2; # make sure it's visible
                }
                if $diff_r > 255 {
                    $diff_r = 255;
                }

                $g1 = gdTrueColorGetGreen($c1);
                $g2 = gdTrueColorGetGreen($c2);
                $diff_g = ($g1 - $g2).abs;

                $diff_g *= 4;  # emphasize
                if $diff_g {
                    $diff_g += gdGreenMax/2; # make sure it's visible
                }
                if $diff_g > 255 {
                    $diff_g = 255;
                }

                $b1 = gdTrueColorGetBlue($c1);
                $b2 = gdTrueColorGetBlue($c2);
                $diff_b = ($b1 - $b2).abs;
                $diff_b *= 4;  # emphasize
                if $diff_b {
                    $diff_b += gdBlueMax/2; # make sure it's visible
                }
                if $diff_b > 255 {
                    $diff_b = 255;
                }

                $result_ret.pixels_changed++;
                if $buf_diff {
                    gdImageSetPixel($buf_diff, $x,$y, gdTrueColorAlpha($diff_r.int, $diff_g.int, $diff_b.int, $diff_a.int));
                }
            } else {
                if $buf_diff {
                    gdImageSetPixel($buf_diff, $x,$y, gdTrueColorAlpha(255,255,255,0));
                }
            }
        }
    }
}

# vim: expandtab shiftwidth=4

